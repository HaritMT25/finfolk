/* The web front end's type check: tsc --checkJs over the files below, with web/types.d.ts (the shared
 * shapes and the window.Evo* globals). Checking only: nothing is emitted, the site still ships its
 * plain scripts as they are. A file is checked when it carries // @ts-check (checkJs stays off, so a
 * file listed without it only lends its types); add a file here and the comment there together.
 *   npx -y -p typescript@5.6.3 tsc -p tsconfig.json      (CI's "web types" job, the same pin)
 * Strict, except noImplicitAny (an unannotated parameter is any, not an error: the files grow JSDoc
 * where a seam needs it, not everywhere at once) and useUnknownInCatchVariables (a caught value is
 * any: these files catch the platform's Errors). */
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "files": [
    "web/types.d.ts",
    "web/ocean_appearance_slots.js",
    "web/ocean_handoff.js",
    "web/ocean_perf.js",
    "web/ocean_config.js",
    "web/ocean_appearance.js"
  ]
}

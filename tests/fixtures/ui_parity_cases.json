{
  "about": "tests/ui_parity_browser.mjs's cases (docs/ui_parity.md): both worlds in the same state, one fresh headless Brave per case and world, full-page pictures with the DOM chrome. Every case starts from the defaults' world (seed, founders) held at tick 0, so a 'run' step reaches the same tick on both pages. A step with 'world' runs on that world only; a 'sel' may be one selector or {classic, ocean}.",
  "version": 1,
  "defaults": {
    "seed": 42,
    "founders": 300,
    "tick": 600,
    "viewport": [1440, 900],
    "dpr": 1,
    "animT": 20.0,
    "visualSeed": 2463534242,
    "settleFrames": 45,
    "hintMs": 9600,
    "locale": "en-US",
    "timezone": "UTC"
  },
  "routes": {
    "source": { "classic": "/web/index.html", "ocean": "/web/ocean.html" },
    "site": { "classic": "/classic.html", "ocean": "/", "oceanAlias": "/ocean.html" }
  },
  "query": {
    "classic": "threads=0&guide=0&intro=0",
    "ocean": "seed={seed}&pop={founders}&guide=0&intro=0"
  },
  "cases": [
    {
      "id": "s0_shell",
      "set": "S0",
      "title": "The shell at tick 600: live, paused, a fish selected, its card expanded with the live numbers open (default colours, the tank)",
      "worlds": ["classic", "ocean"],
      "steps": [
        { "do": "run", "tick": 600, "then": "freeze" },
        { "do": "shot", "name": "live" },
        { "do": "pause" },
        { "do": "shot", "name": "paused" },
        { "do": "select" },
        { "do": "shot", "name": "selected" },
        { "do": "click", "sel": "#iexpand" },
        { "do": "click", "sel": "#readout" },
        { "do": "settle" },
        { "do": "shot", "name": "expanded_numbers" }
      ]
    },
    {
      "id": "s0_family",
      "set": "S0",
      "title": "Explicit Family colours (?colour=family), paused at tick 600, a fish selected",
      "worlds": ["classic", "ocean"],
      "query": "colour=family",
      "steps": [
        { "do": "run", "tick": 600, "then": "pause" },
        { "do": "select" },
        { "do": "shot", "name": "family_selected" }
      ]
    },
    {
      "id": "s0_classic_flat",
      "set": "S0",
      "title": "Classic's WebGL flat view (?view=flat), paused at tick 600, a fish selected (its canvas inspector), then the live numbers",
      "worlds": ["classic"],
      "query": "view=flat",
      "steps": [
        { "do": "run", "tick": 600, "then": "pause" },
        { "do": "select" },
        { "do": "shot", "name": "flat_selected" },
        { "do": "click", "sel": "#readout" },
        { "do": "settle" },
        { "do": "shot", "name": "flat_numbers" }
      ]
    },
    {
      "id": "s0_classic_canvas",
      "set": "S0",
      "title": "Classic's canvas-2D fallback (?gl=0), paused at tick 600, a fish selected",
      "worlds": ["classic"],
      "query": "gl=0",
      "steps": [
        { "do": "run", "tick": 600, "then": "pause" },
        { "do": "select" },
        { "do": "shot", "name": "canvas_selected" }
      ]
    },
    {
      "id": "s2_tabs",
      "set": "S2",
      "title": "The tabs from the keyboard and a pointer: the dashboards' and the setup's (focus ring, Right, End, Home, Left round the end; a pointer's press, then ArrowUp: a speed key once the tab let the focus go)",
      "worlds": ["classic", "ocean"],
      "steps": [
        { "do": "run", "tick": 600, "then": "pause" },
        { "do": "tabTo", "sel": "#dashbtn" },
        { "do": "shot", "name": "dashbtn_focus" },
        { "do": "key", "key": "Enter" },
        { "do": "settle" },
        { "do": "tabTo", "sel": "#dtabs [role=tab][aria-selected=true]" },
        { "do": "shot", "name": "dash_tab_focus" },
        { "do": "key", "key": "ArrowRight" },
        { "do": "shot", "name": "dash_tab_right" },
        { "do": "key", "key": "End" },
        { "do": "shot", "name": "dash_tab_end" },
        { "do": "key", "key": "Home" },
        { "do": "key", "key": "ArrowLeft" },
        { "do": "shot", "name": "dash_tab_home_left" },
        { "do": "click", "sel": "#dtabs [role=tab]:nth-child(2)" },
        { "do": "shot", "name": "dash_tab_pointer" },
        { "do": "key", "key": "Escape" },
        { "do": "settle" },
        { "do": "tabTo", "sel": "#menubtn" },
        { "do": "key", "key": "Enter" },
        { "do": "wait", "ms": 450 },
        { "do": "tabTo", "sel": "#tabs [role=tab][aria-selected=true]" },
        { "do": "shot", "name": "setup_tab_focus" },
        { "do": "key", "key": "End" },
        { "do": "shot", "name": "setup_tab_end" },
        { "do": "key", "key": "ArrowRight" },
        { "do": "shot", "name": "setup_tab_right_wrap" },
        { "do": "click", "sel": "#tabs [role=tab]:nth-child(2)" },
        { "do": "key", "key": "ArrowUp" },
        { "do": "settle" },
        { "do": "shot", "name": "setup_tab_pointer_arrowup" }
      ]
    },
    {
      "id": "s2_controls",
      "set": "S2",
      "title": "Focused controls from the keyboard: a dock button, a setup field (Space types, it does not pause), the View menu and Help opened and closed from the keyboard (the Ocean), the shortcut legend",
      "worlds": ["classic", "ocean"],
      "steps": [
        { "do": "run", "tick": 600, "then": "pause" },
        { "do": "tabTo", "sel": "#pausebtn" },
        { "do": "shot", "name": "pausebtn_focus" },
        { "do": "key", "key": "Escape" },
        { "do": "tabTo", "sel": "#menubtn" },
        { "do": "key", "key": "Enter" },
        { "do": "wait", "ms": 450 },
        { "do": "click", "sel": "#tab-world" },
        { "do": "tabTo", "sel": { "classic": "#seed", "ocean": "#o_seed" } },
        { "do": "key", "key": " " },
        { "do": "settle" },
        { "do": "shot", "name": "field_focus_space" },
        { "do": "key", "key": "Escape" },
        { "do": "settle" },
        { "do": "tabTo", "sel": "#viewmenubtn", "world": "ocean" },
        { "do": "key", "key": "Enter", "world": "ocean" },
        { "do": "wait", "ms": 300, "world": "ocean" },
        { "do": "shot", "name": "view_kb_open", "world": "ocean" },
        { "do": "key", "key": "Escape", "world": "ocean" },
        { "do": "shot", "name": "view_kb_closed", "world": "ocean" },
        { "do": "key", "key": "Escape", "world": "ocean" },
        { "do": "key", "key": "?", "world": "ocean" },
        { "do": "wait", "ms": 300, "world": "ocean" },
        { "do": "shot", "name": "help_legend", "world": "ocean" },
        { "do": "key", "key": "Escape", "world": "ocean" },
        { "do": "shot", "name": "help_kb_closed", "world": "ocean" }
      ]
    }
  ]
}
